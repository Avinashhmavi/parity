# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# --- FieldServe API ---------------------------------------------------------
FIELDOPS_BASE_URL=http://13.233.55.184:8377
FIELDOPS_API_KEY=fk_replace_me

# --- Where the board lives ---------------------------------------------------
# xlsx (default, no credentials) or gsheets
BOARD_BACKEND=xlsx
BOARD_XLSX_PATH=data/FieldServe_Board.xlsx
BOARD_STATE_PATH=data/sync_state.json

# Google Sheets backend only: share the spreadsheet with the service account's email.
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT=/path/to/service-account.json   (or the JSON itself)

# --- Behaviour ---------------------------------------------------------------
# Who wins when both sides changed the same field since the last sync: api | sheet
CONFLICT_POLICY=api
# Requests per minute to stay under (the server's limit is 60).
API_REQUESTS_PER_MINUTE=55
# Comma separated sender domains treated as real OmniMart staff by the noise filter.
TRUSTED_EMAIL_DOMAINS=omnimart.example
# Web app only: sync automatically every N seconds (0 = off).
SYNC_INTERVAL_SECONDS=0

# --- Web app access ------------------------------------------------------------
# Set a password before exposing the console beyond localhost (HTTP Basic, user below).
# BOARD_USER=board
# BOARD_PASSWORD=

# --- Public HTTPS (optional; deploy/deploy.sh sets these for you) ----------------
# DOMAIN=13-233-251-144.sslip.io     # sslip.io maps this name to 13.233.251.144
# COMPOSE_PROFILES=tls               # starts the Caddy reverse proxy with automatic certificates
